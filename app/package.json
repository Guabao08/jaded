{
  "name": "jaded",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "keygen": "node scripts/keygen.mjs",
    "db:local": "node scripts/local-db.mjs",
    "dev:local": "node scripts/dev-local.mjs",
    "postinstall": "prisma generate",
    "prepare": "git -C .. config core.hooksPath .githooks || true",
    "check:ai": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/frank-ruhl-libre": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@resvg/resvg-js": "^2.6.2",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "satori": "^0.63.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "typescript": "^7",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.12"
  },
  "overrides": {
    "fflate": "^0.8.2"
  }
}
