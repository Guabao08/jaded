# Copy to .env (git-ignored) and fill in. Production values live only in the
# host's secret manager. Every value below is a fake placeholder.

# Public base URL of the app. Must be https:// in production. Locally use
# "localhost", not 127.0.0.1 (Next.js rewrites 127.0.0.1 to localhost, which
# breaks sign-in redirects).
APP_URL=http://localhost:3000

# Postgres connection string. For local development, `npm run db:local` starts
# a Postgres server and prints the value to use here.
DATABASE_URL=postgresql://jaded:change-me@localhost:5433/jaded

# Master keys for envelope encryption, as comma-separated <version>:<base64 32-byte key>.
# Generate one with `npm run keygen`. Keep old versions listed until every
# value has been rotated to the active one. This placeholder fails validation
# on purpose, so the app will not start until you set a real key.
ENCRYPTION_MASTER_KEYS=v1:REPLACE_WITH_OUTPUT_OF_npm_run_keygen
ENCRYPTION_ACTIVE_KEY_VERSION=v1

# debug | info | warn | error
LOG_LEVEL=info

# Auth.js secret (signs CSRF tokens, encrypts OAuth state). At least 32 characters.
# Generate with `npm run keygen`.
AUTH_SECRET=REPLACE_WITH_OUTPUT_OF_npm_run_keygen

# GitHub OAuth App for sign-in (github.com > Settings > Developer settings > OAuth Apps).
# Callback URL: <APP_URL>/api/auth/callback/github
AUTH_GITHUB_ID=replace-with-oauth-app-client-id
AUTH_GITHUB_SECRET=replace-with-oauth-app-client-secret

# Numeric GitHub user IDs allowed to sign in during testing, comma-separated.
# Find yours at https://api.github.com/users/<your-login> (the "id" field).
AUTH_ALLOWED_GITHUB_IDS=0

# GitHub App (repository access and push webhooks). Leave these out until the
# App exists; the app runs without them and shows "GitHub not configured".
# Set all six or none. See app/README.md, "GitHub App", for how to create it.
# GITHUB_APP_ID=123456
# GITHUB_APP_SLUG=jaded-dev
# GITHUB_APP_PRIVATE_KEY=base64-of-the-downloaded-pem-file
# GITHUB_APP_CLIENT_ID=replace-with-github-app-client-id
# GITHUB_APP_CLIENT_SECRET=replace-with-github-app-client-secret
# GITHUB_WEBHOOK_SECRET=REPLACE_WITH_OUTPUT_OF_npm_run_keygen

# Post writing (Phase 3). Get a key at https://aistudio.google.com/apikey.
# Server-only: never prefix with NEXT_PUBLIC_. Without it, posts wait with a note.
# GEMINI_API_KEY=replace-with-your-gemini-api-key
# GEMINI_MODEL=gemini-3.8-flash
# Estimated AI spend allowed per workspace per month, in US dollars.
# AI_MONTHLY_CAP_USD=10
